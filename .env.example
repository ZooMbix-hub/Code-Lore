# Подключение к PostgreSQL.
# Локально: контейнер из docker-compose.yml (pnpm db:up).
# На Vercel: строка подключения из панели Neon/Supabase
# (для продакшена используйте pooled-endpoint — у Neon это суффикс -pooler).
DATABASE_URL=postgres://code-lore:code-lore@localhost:5432/code-lore

# Креды контейнера PostgreSQL в docker-compose.yml.
# Раскомментируйте и переопределите при необходимости —
# тогда те же значения нужно указать и в DATABASE_URL.
# POSTGRES_USER=code-lore
# POSTGRES_PASSWORD=code-lore
# POSTGRES_DB=code-lore
# POSTGRES_PORT=5432
