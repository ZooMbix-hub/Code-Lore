{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "jsx-a11y", "nextjs", "react", "react-perf", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2025": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    }
  },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "no-console": "warn",
    "prefer-const": "warn",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "react/error-boundaries": "warn",
    "react/globals": "warn",
    "react/immutability": "warn",
    "react/incompatible-library": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/set-state-in-render": "warn",
    "react/static-components": "warn",
    "react/use-memo": "warn",
    "react/unsupported-syntax": "warn",
    "react/void-use-memo": "warn",
    "react/no-deriving-state-in-effects": "warn",
    "react/invariant": "warn",
    "react/rule-suppression": "warn",
    "react/syntax": "warn",
    "react/todo": "warn",
    "react/capitalized-calls": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "react/hooks": "warn",
    "react/memo-dependencies": "warn",
    "no-shadow": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "vitest/require-mock-type-parameters": "off",
    "no-underscore-dangle": "off",
    "import/no-named-as-default": "off",
    "import/no-unassigned-import": "off"
  }
}
